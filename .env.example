GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=""
GOOGLE_DRIVE_REPORTS_FOLDER_ID=""
GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES="false"

# Optional: set to "true" for managed Postgres that needs SSL, "false" for local Postgres.
DATABASE_SSL="true"

# --- Payroll V2 (Absensi + Wallet Gaji + Wallet Fee Pool) ---
# Global switch untuk sistem payroll baru. Kalau "false", hook POS/attendance tetap jalur lama.
PAYROLL_V2_ENABLED="false"
