# ============================================================
# DATABASE: Supabase PostgreSQL
# ============================================================
# Format: postgresql://postgres.[project-id]:[password]@db.[project-id].supabase.co:5432/postgres
# Dapatkan dari: Supabase Dashboard → Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:your_password@db.your_project_id.supabase.co:5432/postgres

# SSL enforcement (Supabase selalu memerlukan SSL)
# DATABASE_SSL=true (default)

# Untuk local development: gunakan PGlite (tidak perlu DATABASE_URL)
# Uncomment untuk development lokal tanpa Supabase:
# GARAGE_DB_DRIVER=pglite
# PGLITE_DATA_DIR=./.pglite-data

# Supabase client-side config (project URL + publishable/anon key).
# Terpisah dari DATABASE_URL di atas — dipakai kalau ada fitur yang butuh
# Supabase client SDK langsung dari browser (mis. Storage/Realtime).
# Dapatkan dari: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ============================================================
# AUTHENTICATION: Better Auth
# ============================================================
# Generate secret dengan: node -e "console.log(crypto.randomBytes(64).toString('hex'))"
BETTER_AUTH_SECRET=your_64_char_random_secret_here

# Base URL untuk Better Auth (sesuaikan dengan domain production)
BETTER_AUTH_URL=http://localhost:3001

# Session expiry dalam jam (default: 24)
GARAGE_SESSION_EXPIRES_HOURS=24

# ============================================================
# APLIKASI
# ============================================================
NODE_ENV=development

# Payroll V2 feature flag
PAYROLL_V2_ENABLED=false

# Public URLs
GARAGE_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_GARAGE_PUBLIC_BASE_URL=http://localhost:3001

# ============================================================
# OPSIONAL: Trusted origins untuk CORS
# ============================================================
GARAGE_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================
# OPSIONAL: External Services
# ============================================================
# AI Providers
GOOGLE_GENERATIVE_AI_KEY=your_key_here

# WhatsApp/Messaging
WHATSAPP_API_KEY=your_key_here

# Voice/TTS
ELEVENLABS_API_KEY=your_key_here

# ============================================================
# OPSIONAL: Storage & Uploads
# ============================================================
NEXT_PUBLIC_UPLOADS_URL=https://yourdomain.com/uploads
