# =============================================================================
# DATABASE — PRODUKSI HOSTINGER WEB APP + SUPABASE (WAJIB)
# =============================================================================
# Ambil connection string di:
#   Supabase Dashboard → Settings → Database → Connection string → URI
#
# GUNAKAN CONNECTION POOLER (port 6543) untuk aplikasi (serverless-friendly):
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# GUNAKAN DIRECT (port 5432) untuk migrasi one-off (drizzle migrate):
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# =============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# WAJIB set "postgres" di produksi Hostinger. Jika kosong/tidak diset, app
# fallback ke PGlite dev → data hilang tiap redeploy. Nilai ini yang mencegah.
GARAGE_DB_DRIVER="postgres"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://YOUR_LAN_IP:3001"
GARAGE_TRUSTED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001,http://YOUR_LAN_IP:3001"
GARAGE_PUBLIC_BASE_URL="http://YOUR_LAN_IP:3001"
NEXT_PUBLIC_GARAGE_PUBLIC_BASE_URL="http://YOUR_LAN_IP:3001"

# Social publisher (server-only)
SOCIAL_PUBLISHER_ENCRYPTION_KEY="GANTI_DENGAN_RANDOM_SECRET_PANJANG"
SOCIAL_PUBLISHING_LIVE_ENABLED="false"
META_CLIENT_ID=""
META_CLIENT_SECRET=""
