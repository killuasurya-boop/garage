# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local database & scratch
/.garage-db/
/.tmp/
/.codex-screenshots/

# runtime user uploads (selfie absensi, chat, dll) — bukan source
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev/process logs
/logs/
*.log
codex-*.log
.codex-*.log
.next-dev*.log
dev-server.*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated voice MP3 (regenerate with npm run voice:generate-mp3)
/exports/voice-mp3/*.mp3
