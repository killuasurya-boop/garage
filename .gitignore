# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local database & scratch
/.garage-db/
/.garage-db.*/
/.tmp/
/.codex-screenshots/
/backups/

# runtime user uploads (selfie absensi, chat, dll) — bukan source
/public/uploads/

# sertifikat dev HTTPS lokal (jangan commit kunci privat)
/certs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev/process logs
/logs/
*.log
codex-*.log
.codex-*.log
.next-dev*.log
dev-server.*.log

# env files (can opt-in for committing if needed)
.env*

# MCP config — berisi API token rahasia, jangan commit
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated voice MP3 (regenerate with npm run voice:generate-mp3)
/exports/voice-mp3/*.mp3

# python bytecode cache (ui-ux-pro-max skill)
.claude/skills/**/__pycache__/

# cloned skill source (not needed — uipro-cli installed it to .claude/skills/)
/ui-ux-pro-max-skill/

# Local DB snapshot backups (jangan masuk repo)
backups/pglite-snapshot-*/

# ── Tambalan celah (cegah `git add -A` nyeret file besar) ──
# Nested node_modules sub-project (mis. garage-profitmax/) — bukan hanya root.
**/node_modules/
# Data DB pglite lokal (data, bukan source).
/.pglite-data/
/pglite-data*/
# Tooling / agent scratch & laporan generated.
/.agent/
/.codex/
/.stitch/
/.garage/
# Output generated (moodboards, dll).
/outputs/

testsprite_tests\tmp\config.json

# local agent tooling & dev config (jangan commit)
/.agents/
/data/
.claude/launch.json
