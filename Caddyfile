# Ganti app.namawarung.com dengan domain Anda (sudah diarahkan A record ke IP VPS).
# Caddy otomatis terbitkan & perpanjang sertifikat HTTPS (Let's Encrypt).
{$GARAGE_DOMAIN} {
	encode gzip zstd

	# HTTPS wajib selama 1 tahun (browser menolak turun ke HTTP).
	header Strict-Transport-Security "max-age=31536000"
	header -Server

	# Upload gambar menu bisa besar — naikkan limit body.
	request_body {
		max_size 12MB
	}

	# IP klien asli dari koneksi (bukan header kiriman klien) untuk rate limit.
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# www.<domain> → domain utama (DNS www sudah CNAME ke domain utama).
www.{$GARAGE_DOMAIN} {
	redir https://{$GARAGE_DOMAIN}{uri} permanent
}

# Situs tambahan di VPS (mis. staging.caddy dari scripts/staging-setup.sh). Folder boleh kosong.
import sites/*.caddy
