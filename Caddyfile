# Ganti app.namawarung.com dengan domain Anda (sudah diarahkan A record ke IP VPS).
# Caddy otomatis terbitkan & perpanjang sertifikat HTTPS (Let's Encrypt).
{$GARAGE_DOMAIN} {
	encode gzip zstd

	# HTTPS wajib selama 1 tahun (browser menolak turun ke HTTP).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	# Upload gambar menu bisa besar — naikkan limit body.
	request_body {
		max_size 12MB
	}

	# IP klien asli dari koneksi (bukan header kiriman klien) untuk rate limit.
	# SATU pintu lineup GIGS (Owner 18 Nov 2026): lineup halaman event = Lineup Garage OS (sama dengan beranda).
	# Hanya GET /event/<slug>/api/public/(lineup|live|config|participants|readiness|closeout), /api/sponsor/summary dan /public/app.js
	# ke Garage; sisanya (termasuk changes, logo, foto) tetap ke platform.
	@gigsLineup {
		method GET
		path_regexp gigsLineup ^/event/([a-z0-9][a-z0-9-]{0,80})/api/public/(lineup|live|config|participants|readiness|closeout)/?$
	}
	handle @gigsLineup {
		rewrite * /api/public/gigs/{re.gigsLineup.1}/{re.gigsLineup.2}
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Transparansi dana (Owner 18 Nov 2026): ringkasan dana publik dari Garage bila Owner mengaktifkannya.
	@gigsSummary {
		method GET
		path_regexp gigsSummary ^/event/([a-z0-9][a-z0-9-]{0,80})/api/sponsor/summary/?$
	}
	handle @gigsSummary {
		rewrite * /api/public/gigs/{re.gigsSummary.1}/sponsor-summary
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Pendaftaran kreator/sponsor/kru dari form halaman event (POST) → Garage OS (Owner 18 Nov 2026). Event belum tertaut /
	# ID pendaftaran lama → Garage meneruskannya kembali ke platform.
	@gigsRegister {
		method POST
		path_regexp gigsRegister ^/event/([a-z0-9][a-z0-9-]{0,80})/api/public/(register|registration/(?:lookup|update|setlist))$
	}
	handle @gigsRegister {
		rewrite * /api/public/gigs/{re.gigsRegister.1}/{re.gigsRegister.2}
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# app.js halaman event GIGS + koreksi kecil (kartu lineup baru langsung tampil, SURAU→SURAI) lewat Garage OS.
	@gigsAppJs {
		method GET
		path_regexp gigsAppJs ^/event/([a-z0-9][a-z0-9-]{0,80})/public/app\.js$
	}
	handle @gigsAppJs {
		rewrite * /api/public/gigs/{re.gigsAppJs.1}/app-js
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# GARAGE EVENT PLATFORM (stack terpisah "garage-event", /root/garage-event)
	@garageEvent path /event /event/*
	handle @garageEvent {
		reverse_proxy garage-event-platform:4400 {
			header_up X-Real-IP {remote_host}
		}
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# www.<domain> → domain utama (DNS www sudah CNAME ke domain utama).
www.{$GARAGE_DOMAIN} {
	redir https://{$GARAGE_DOMAIN}{uri} permanent
}

# Situs tambahan di VPS (mis. staging.caddy dari scripts/staging-setup.sh). Folder boleh kosong.
import sites/*.caddy
