{
  "name": "garage-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3001",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certs/key.pem --experimental-https-cert ./certs/cert.pem --hostname 0.0.0.0 --port 3001",
    "pos:kiosk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-pos-kiosk.ps1",
    "print:server": "node scripts/thermal-print-server.js",
    "print:start": "node scripts/thermal-print-server.js",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "start:lan": "next start -H 0.0.0.0 -p 3001",
    "lint": "eslint",
    "check:permissions": "tsx src/scripts/check-permissions.ts",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "smoke": "tsx src/scripts/smoke-garage-lan.ts",
    "readiness:audit": "tsx src/scripts/garage-readiness-audit.ts",
    "security:audit": "tsx src/scripts/garage-security-audit.ts",
    "pilot:uat": "tsx src/scripts/garage-pilot-uat.ts",
    "final-mvp:uat": "tsx src/scripts/garage-final-mvp-uat.ts",
    "wms:uat": "tsx src/scripts/garage-wms-operational-uat.ts",
    "ai:evaluate": "tsx src/scripts/run-garage-ai-evals.ts",
    "ai:shift-copilot": "tsx src/scripts/run-shift-copilot.ts",
    "voice:generate-mp3": "tsx src/scripts/generate-voice-mp3.ts",
    "voice:publish-scenarios": "tsx src/scripts/publish-scenario-audio.ts",
    "voice:test-elevenlabs": "tsx src/scripts/test-elevenlabs-tts.ts",
    "social:migrate-youtube": "tsx src/scripts/migrate-legacy-youtube-token.ts",
    "voice:generate-smart-notif": "tsx scripts/generate-smart-notif-audio.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runner": "tsx src/db/migrate.ts",
    "db:bootstrap-pglite": "tsx src/scripts/bootstrap-pglite.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:catalog": "tsx src/db/seed.ts --sync-catalog",
    "payroll:seed": "tsx src/scripts/seed-payroll-employees.ts",
    "absen:https": "node scripts/absen-https-proxy.mjs",
    "db:restore": "node scripts/restore-db-backup.mjs",
    "db:reset-demo": "tsx src/db/reset-demo.ts",
    "db:reset-opening": "tsx src/db/reset-grand-opening.ts",
    "gladi:setup": "tsx src/scripts/gladi-setup.ts",
    "gladi:server": "node scripts/gladi-server.mjs",
    "gladi:run": "tsx src/scripts/gladi-scenario.ts",
    "qa:db": "tsx src/scripts/qa-db-audit.ts",
    "qa:api": "tsx src/scripts/qa-api-audit.ts --live http://127.0.0.1:3002 --owner-fuzz",
    "qa:uat": "tsx src/scripts/qa-uat.ts",
    "qa:pages": "tsx src/scripts/qa-page-crawl.ts",
    "qa:load": "tsx src/scripts/qa-load.ts",
    "db:repair-mvp": "tsx src/scripts/garage-db-repair-mvp.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pos": "vitest run src/lib/garage-data.test.ts",
    "design:gen": "python \".claude/skills/ui-ux-pro-max/scripts/search.py\" --design-system --persist -p \"Garage OS\"",
    "design:gen:page": "python \".claude/skills/ui-ux-pro-max/scripts/search.py\" --design-system --persist -p \"Garage OS\" --page",
    "design:search": "python \".claude/skills/ui-ux-pro-max/scripts/search.py\"",
    "docs:guides": "tsx scripts/generate-role-guides.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/core": "1.7.12",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-fetch/fetch": "1.3.2",
    "@electric-sql/pglite": "^0.4.6",
    "@google/generative-ai": "^0.24.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.7.12",
